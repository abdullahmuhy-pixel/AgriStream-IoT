@model List<AppUser>
@{
    ViewData["Title"] = "Users";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">User management</h1>
    <a asp-action="Create" class="btn btn-success">Add user</a>
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<div class="card stat-card">
    <div class="card-body">
        <p class="text-muted small">Stored in the <code>Users</code> and <code>Roles</code> tables in Azure SQL Database. Passwords are saved as salted hashes.</p>
        <table class="table table-sm align-middle">
            <thead><tr><th>ID</th><th>Username</th><th>Role</th><th>Status</th><th>Created (UTC)</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.UserId</td>
                    <td>@u.Username</td>
                    <td><span class="badge bg-success">@u.Role?.RoleName</span></td>
                    <td>@(u.IsActive ? "Active" : "Disabled")</td>
                    <td>@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (u.Username != User.Identity?.Name)
                        {
                            <form asp-action="ToggleActive" asp-route-id="@u.UserId" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary">@(u.IsActive ? "Disable" : "Enable")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
